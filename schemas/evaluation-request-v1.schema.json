{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Instructor evaluation request v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task",
    "prediction_schema_version",
    "dataset",
    "input_sha256",
    "records"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "task": {
      "const": "booking_predictions"
    },
    "prediction_schema_version": {
      "const": "1.0"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "schema_version",
        "booking_count"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": "1.0"
        },
        "booking_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "events",
        "predictions",
        "truth"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "events": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "predictions": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "truth": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "booking_id",
          "prediction",
          "expected"
        ],
        "properties": {
          "booking_id": {
            "type": "string",
            "pattern": "^BOOK-[0-9]{6,}(?![\\s\\S])"
          },
          "prediction": {
            "$ref": "#/$defs/labels"
          },
          "expected": {
            "$ref": "#/$defs/labels"
          }
        }
      }
    }
  },
  "$defs": {
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "root_cause_service",
        "affected_services"
      ],
      "properties": {
        "status": {
          "enum": [
            "confirmed",
            "failed",
            "pending"
          ]
        },
        "root_cause_service": {
          "enum": [
            null,
            "booking",
            "payment",
            "supplier",
            "notification"
          ]
        },
        "affected_services": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "booking",
              "payment",
              "supplier",
              "notification"
            ]
          }
        }
      }
    }
  }
}
