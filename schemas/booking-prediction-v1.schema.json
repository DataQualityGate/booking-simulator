{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Booking prediction v1.0 (one JSONL record)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "booking_id", "status", "root_cause_service", "affected_services"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "booking_id": {"type": "string", "pattern": "^BOOK-[0-9]{6,}(?![\\s\\S])"},
    "status": {"enum": ["confirmed", "failed", "pending"]},
    "root_cause_service": {"enum": [null, "booking", "payment", "supplier", "notification"]},
    "affected_services": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["booking", "payment", "supplier", "notification"]}
    }
  }
}
