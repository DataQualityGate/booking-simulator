{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DataQualityGate/booking-simulator/schemas/sdlc-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "challenge_id",
    "commit_sha",
    "rationale",
    "intent",
    "spec",
    "tests",
    "reviews",
    "human_decisions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "challenge_id": {
      "enum": [
        "supplier-recovery-v1",
        "confirmation-context-v1"
      ]
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Repository-relative POSIX file path or HTTPS URL without credentials or query. Existence is checked only for local references when --repository is supplied."
    },
    "spec": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Repository-relative POSIX file path or HTTPS URL without credentials or query. Existence is checked only for local references when --repository is supplied."
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "result",
          "artifact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "artifact": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Repository-relative POSIX file path or HTTPS URL without credentials or query. Existence is checked only for local references when --repository is supplied."
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reviewer",
          "artifact",
          "findings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "artifact": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Repository-relative POSIX file path or HTTPS URL without credentials or query. Existence is checked only for local references when --repository is supplied."
          },
          "findings": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "severity",
                "status",
                "rationale"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "severity": {
                  "enum": [
                    "info",
                    "minor",
                    "major",
                    "critical"
                  ]
                },
                "status": {
                  "enum": [
                    "open",
                    "fixed",
                    "accepted"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    },
    "human_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "rationale",
          "finding_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "decision": {
            "enum": [
              "approve",
              "revise",
              "accept_risk"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "finding_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
